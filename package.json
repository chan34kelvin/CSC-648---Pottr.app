  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "concurrently --kill-others \"npm run frontend\" \"npm run backend\"",
    "test": "cd application/backend && echo \"Error: no test specified\" && exit 1",
    "frontend": "cd application/frontend && npm start",
    "backend": "cd application/backend && npm run start",
    "start:dev": "concurrently --kill-others \"npm run frontend\" \"npm run backend\"",
    "install:app": "concurrently --kill-others \"npm run install:frontend\" \"npm run install:backend\"",
    "install:frontend": "cd application/frontend && npm i",
    "install:backend": "cd application/backend && npm i"
  },
